{
  "agents": {
    "defaults": {
      "workspace": "/app/data/workspaces/lars-van-der-berg",
      "model": "glm-5.1:cloud",
      "provider": "ollamaCloud",
      "maxTokens": 8192,
      "contextWindowTokens": 32768,
      "temperature": 0.8,
